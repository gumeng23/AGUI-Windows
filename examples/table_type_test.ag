window("type", 600, 360)
t = table(["A", "B"], [["x", "old"], ["y", "2"]], h=150)
t.set_cell(0, 1, "999")
print("direct=" + t.get_cell(0, 1))
t.edit_cell(0, 1)
t.set_edit_text("777")
print("before=" + t.get_cell(0, 1))
t.end_edit(true)
print("after=" + t.get_cell(0, 1))
print("edittext=" + t.edit_text)
after(1500, quit)
