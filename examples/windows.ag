# windows.ag —— 多窗口示例
main = window("多窗口示例 - 主窗口", w=560, h=360)
label("这是主窗口。点击下面的按钮会创建一个从属窗口。")
open = button("打开从属窗口", w=180)

on open.click:
    sub = window("从属窗口", w=440, h=280, parent=main)
    label("这是第二个窗口，拥有自己的控件和布局。")
    hint = label("它会跟随主窗口最小化，并保持在主窗口之上。")
    close = button("关闭本窗口", w=160)
    on close.click:
        sub.close()

