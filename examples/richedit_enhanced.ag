win = window("RichEdit 增强", w=600, h=420)
r = richedit("Agui 富文本", h=220)
r.append("：选区、链接和图片", bold=true, color="#1D4ED8")
r.append("\n点击链接会调用系统浏览器。", italic=true)
r.link("Agui 官网", "https://example.com")
r.insert_image("../assets/agui.png", w=160, h=100)
print("selection", r.selection_start, r.selection_end, r.selected_text)
r.select_range(0, 4)
print("selected", r.selected_text)
after(3000, quit)
