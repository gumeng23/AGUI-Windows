window("probe", 600, 400)
t = table(["A", "B"], [["a1", "b1"], ["a2", "b2"]], x=20, y=20, w=500, h=200)
print("rows=", t.row_count, "cols=", t.column_count)
print("cell00=", t.get_cell(0, 0), "cell11=", t.get_cell(1, 1))

on t.select:
    print("select event, selected=", t.selected)

func pick():
    t.select(1)
    print("selected inside callback=", t.selected)

after(200, pick)
after(900, quit)
