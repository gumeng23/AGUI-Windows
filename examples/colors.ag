# 自绘按钮与颜色演示
window("自绘按钮", 560, 380, bg="#F8FAFC")

label("原生按钮的 fg/bg 往往无效，现在按钮会自绘：", x=24, y=24)
button("蓝色主要按钮", x=24, y=64, w=200, h=44, bg="#2563EB", fg="#FFFFFF")
button("红色危险按钮", x=248, y=64, w=200, h=44, bg="#DC2626", fg="#FFFFFF")
button("浅色按钮", x=24, y=124, w=200, h=44, bg="#E2E8F0", fg="#0F172A")
button("默认按钮", x=248, y=124, w=200, h=44)

checkbox("启用自绘外观", x=24, y=190, checked=true)
edit("可以直接编辑文字", x=24, y=228, w=424)
label("提示：按钮文字、背景色、前景色均可设置。", x=24, y=278, fg="#475569")
