#target android
#name Agui 原生控件
#package com.agui.actionbar
#version 0.9.4
#permission android.permission.VIBRATE android.permission.POST_NOTIFICATIONS android.permission.CAMERA android.permission.RECORD_AUDIO android.permission.ACCESS_FINE_LOCATION android.permission.FOREGROUND_SERVICE android.permission.FOREGROUND_SERVICE_DATA_SYNC

win = window("Agui 原生控件")

bar = actionbar("Agui 原生")
about = bar.add_action("关于")
refresh = bar.add_action("刷新")

on about.click:
    alert("关于 Agui", "原生 ActionBar、标准对话框与 Android View 运行时。")

on refresh.click:
    status.text = "已刷新（" + str(len(items)) + " 项）"
    vibrate(80)
    notify("Agui 原生", "列表已刷新")
    set_clipboard("Agui Android")

title = label("原生 View 组件", size=24, fg="#9A3412")
status = label("点击右上角菜单", size=14, fg="#78716C")

info = button("设备信息")
on info.click:
    status.text = device_info() + " · 电量 " + str(battery()) + "% · " + network()

items = ["相机", "定位", "通知", "分享"]
for name in items:
    label("• " + name, size=16)

t = table(["能力", "状态"], [["ActionBar", "原生"], ["表格", "原生 TableLayout"], ["对话框", "AlertDialog"]])

tabsui = tabs()
p1 = tabsui.add_page("概览")
label("第一页：原生 View 子集", parent=p1)
p2 = tabsui.add_page("系统")
label("第二页：通知、震动、剪贴板、分享", parent=p2)
tabsui.active = 1

fg = button("启动前台服务")
on fg.click:
    foreground("Agui 后台任务", "正在后台运行，点击返回应用")
    status.text = "前台服务已启动"

stopfg = button("停止前台服务")
on stopfg.click:
    stop_foreground()
    status.text = "前台服务已停止"

on win.intent:
    status.text = "收到深链：" + win.intent

cam = button("拍照")
on cam.click:
    camera()

loc = button("读取最后位置")
on loc.click:
    pos = location()
    if pos == "":
        status.text = "暂无位置（请先授权定位并让系统定位一次）"
    else:
        status.text = "位置：" + pos

on win.file:
    status.text = "文件：" + win.last_file

rec = button("开始录音")
on rec.click:
    start_record()
    status.text = "录音中……"

stoprec = button("停止录音")
on stoprec.click:
    stop_record()

acc = button("读取加速度")
on acc.click:
    v = sensor("accelerometer")
    if v == "":
        status.text = "暂无加速度数据"
    else:
        status.text = "加速度：" + v

perm = button("申请相机/麦克风权限组")
on perm.click:
    request_permissions("android.permission.CAMERA", "android.permission.RECORD_AUDIO")
    status.text = "已发起权限组请求"

on win.permission:
    if win.permission_granted:
        status.text = "已授权：" + win.permission_name
    elif permission_rationale(win.permission_name):
        status.text = "可以再次申请：" + win.permission_name
    else:
        status.text = "已拒绝，请到应用设置中开启：" + win.permission_name

settingsbtn = button("打开应用设置")
on settingsbtn.click:
    open_settings()

intentbtn = button("打开系统设置（Intent）")
on intentbtn.click:
    intent("android.settings.SETTINGS")

items = []
for i in range(1000):
    items.append("列表项 " + str(i))
listbox = list(items)

richbox = rich("[b]富文本[/b] 支持 [color=#C2410C]颜色[/color] 与 [i]斜体[/i]。")

treeview = tree([["原生 UI", [["ActionBar", []], ["表格", []], ["标签页", []]]], ["系统", [["通知", []], ["保存文件", []]]]])
on treeview.select:
    status.text = "树节点：" + str(treeview.selected)
okbtn = button("确认示例", w=140)
on okbtn.click:
    confirm("确认操作", "要更新状态栏吗？")

on win.confirm:
    if win.confirm:
        status.text = "已确认"
    else:
        status.text = "已取消"

savebtn = button("保存文本", w=140)
on savebtn.click:
    save_file("agui-demo.txt", "Agui Android 原生保存示例\n")

on win.saved:
    status.text = "已保存：" + win.saved

rf = refresh()
label("下拉刷新试试", parent=rf)
on rf.refresh:
    status.text = "下拉刷新已触发"

pg = pager()
pg1 = pg.add_page("第一页")
label("左右滑动可以翻页", parent=pg1)
pg2 = pg.add_page("第二页")
label("这是第二页", parent=pg2)
goto2 = button("切到第二页", w=160, parent=pg1)
on goto2.click:
    pg.active = 1
    status.text = "Page 2"

button("返回", w=120)
on win.close:
    toast("再见")
