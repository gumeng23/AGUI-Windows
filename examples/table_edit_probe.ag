window("table edit probe", 640, 420)
t = table(["名称", "数量"], [["苹果", "12"], ["香蕉", "3"]], h=180, editable=true)
t.edit_cell(0, 1)
t.set_edit_text("777")
t.end_edit(true)
print("cell", t.get_cell(0, 1), "editing", t.editing)
t.sort(1)
print("sorted", t.get_cell(0,0), t.get_cell(1,0))
after(600, quit)
