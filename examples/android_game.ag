#target android
#name 星野跳跃
#package com.agui.jump
#version 0.1.0
#icon ../assets/agui.png

win = window("星野跳跃", w=360, h=640)
title = label("触摸屏幕，让星野跳起来", fg="#7c2d12")
c = canvas(bg="#0f172a")
score_label = label("得分 0", fg="#0f172a")

x = 170.0
y = 420.0
vy = 0.0
ground = 540.0
score = 0
best = 0
playing = true

func reset():
    x = 170.0
    y = 420.0
    vy = 0.0
    score = 0
    playing = true

func update(dt):
    if playing:
        vy = vy + 1500.0 * dt
        y = y + vy * dt
        if y >= ground:
            y = ground
            vy = 0
        if touch_pressed:
            vy = -560.0
        if touch_down and touch_x < 90:
            x = max(30, x - 220 * dt)
        if touch_down and touch_x > 270:
            x = min(310, x + 220 * dt)
    c.clear()
    c.rect(0, ground + 28, 360, 80, color="#1e293b", fill=true)
    for i in range(6):
        c.circle(40 + i * 58, ground + 48, 4, color="#64748b", fill=true)
    c.circle(x, y, 26, color="#f472b6", fill=true)
    c.circle(x - 9, y - 6, 3, color="#ffffff", fill=true)
    c.circle(x + 9, y - 6, 3, color="#ffffff", fill=true)
    c.rect(x - 8, y + 4, 16, 3, color="#be185d", fill=true)
    c.text(18, 46, "得分 " + str(score), color="#f8fafc", size=22)
    c.text(18, 76, "最高 " + str(best), color="#94a3b8", size=15)
    if not playing:
        c.rect(40, 180, 280, 150, color="#1e293b", fill=true)
        c.text(110, 240, "游戏结束", color="#fda4af", size=26)
        c.text(82, 282, "点屏幕重新开始", color="#e2e8f0", size=18)

on c.click:
    touched()

func touched():
    if not playing:
        if score > best:
            best = score
        reset()
        return
    score = score + 1
    if score > best:
        best = score

game_loop(update, fps=60)
