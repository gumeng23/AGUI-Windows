    @Override public void setTable(final long id, final String json) {
        runOnUiThread(new Runnable() {
            @Override public void run() {
                View v = views.get(id);
                if (!(v instanceof TableLayout)) return;
                TableLayout table = (TableLayout) v;
                table.removeAllViews();
                try {
                    JSONArray rows = new JSONArray(json);
                    for (int r = 0; r < rows.length(); r++) {
                        JSONArray row = rows.getJSONArray(r);
                        TableRow tr = new TableRow(MainActivity.this);
                        for (int c = 0; c < row.length(); c++) {
                            TextView cell = new TextView(MainActivity.this);
                            cell.setText(row.optString(c));
                            cell.setTextSize(r == 0 ? 14 : 15);
                            cell.setPadding(dp(6), dp(7), dp(6), dp(7));
                            if (r == 0) {
                                cell.setTextColor(Color.WHITE);
                                cell.setBackgroundColor(Color.rgb(154, 52, 18));
                            } else {
                                cell.setTextColor(Color.rgb(55, 45, 40));
                                if (r % 2 == 0) cell.setBackgroundColor(Color.rgb(255, 248, 241));
                            }
                            tr.addView(cell, new TableRow.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
                        }
                        table.addView(tr, new TableLayout.LayoutParams(
                                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
                    }
                } catch (Exception e) {
                    Toast.makeText(MainActivity.this, "表格数据错误：" + e.getMessage(), Toast.LENGTH_SHORT).show();
                }
            }
        });
    }

