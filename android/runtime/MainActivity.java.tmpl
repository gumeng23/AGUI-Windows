                startActivityForResult(it, REQ_PICK);
            }
        });
    }

    @Override protected void onActivityResult(int requestCode, int resultCode, Intent data) {
        super.onActivityResult(requestCode, resultCode, data);
        if (resultCode != RESULT_OK) return;
        if (requestCode == REQ_CAMERA) {
            if (data == null || data.getExtras() == null) return;
            Bitmap bmp = (Bitmap) data.getExtras().get("data");
            if (bmp == null) return;
            try {
                File out = new File(getCacheDir(), "agui-camera-" + System.currentTimeMillis() + ".jpg");
                FileOutputStream fos = new FileOutputStream(out);
                bmp.compress(Bitmap.CompressFormat.JPEG, 90, fos);
                fos.close();
                Mobile.dispatchFile(out.getAbsolutePath());
            } catch (Exception e) {
                Toast.makeText(this, "保存照片失败：" + e.getMessage(), Toast.LENGTH_LONG).show();
            }
            return;
        }
        if (data == null || data.getData() == null) return;
        Uri uri = data.getData();
        if (requestCode == REQ_SAVE) {
            try {
                java.io.OutputStream out = getContentResolver().openOutputStream(uri);
                if (out == null) throw new Exception("无法写入文件");
                out.write(pendingSaveContent.getBytes("UTF-8"));
                out.close();
                Mobile.dispatchSaved(uri.toString());
            } catch (Exception e) {
                Toast.makeText(this, "保存失败：" + e.getMessage(), Toast.LENGTH_LONG).show();
            }
            return;
        }
        if (requestCode != REQ_PICK) return;
        try {
            File out = new File(getCacheDir(), "agui-pick-" + System.currentTimeMillis() + ".bin");
            InputStream in = getContentResolver().openInputStream(uri);
            if (in == null) throw new Exception("无法打开文件");
            FileOutputStream fos = new FileOutputStream(out);
            byte[] buf = new byte[8192];
            int n;
            while ((n = in.read(buf)) > 0) fos.write(buf, 0, n);
            fos.close();
            in.close();
            Mobile.dispatchFile(out.getAbsolutePath());
        } catch (Exception e) {
            Toast.makeText(this, "读取文件失败：" + e.getMessage(), Toast.LENGTH_LONG).show();
        }
    }

    @Override public void saveFile(final String name, final String content) {
        runOnUiThread(new Runnable() {
            @Override public void run() {
                pendingSaveContent = content;
                Intent it = new Intent(Intent.ACTION_CREATE_DOCUMENT);
                it.addCategory(Intent.CATEGORY_OPENABLE);
                it.setType("text/plain");
                it.putExtra(Intent.EXTRA_TITLE, name);
                startActivityForResult(it, REQ_SAVE);
            }
        });
    }

    @Override public void requestPermission(final String name) {
        runOnUiThread(new Runnable() {
            @Override public void run() {
                if (android.os.Build.VERSION.SDK_INT >= 23) {
                    requestPermissions(new String[]{name}, REQ_PERM);
                } else {
                    Mobile.dispatchPermission(name, true);
                }
            }
        });
    }

    @Override public void requestPermissions(final String names) {
        runOnUiThread(new Runnable() {
            @Override public void run() {
                String[] list = names.split(",");
                if (android.os.Build.VERSION.SDK_INT >= 23) {
                    requestPermissions(list, REQ_PERM);
                } else {
                    for (String name : list) Mobile.dispatchPermission(name, true);
                }
            }
        });
    }

    @Override public void onRequestPermissionsResult(int requestCode, String[] permissions, int[] grantResults) {
        super.onRequestPermissionsResult(requestCode, permissions, grantResults);
        if (requestCode != REQ_PERM || permissions == null || permissions.length == 0) return;
        for (int i = 0; i < permissions.length; i++) {
            boolean ok = grantResults != null && i < grantResults.length
                    && grantResults[i] == android.content.pm.PackageManager.PERMISSION_GRANTED;
            Mobile.dispatchPermission(permissions[i], ok);
        }
    }

    @Override public void camera() {
        runOnUiThread(new Runnable() {
            @Override public void run() {
                Intent it = new Intent(android.provider.MediaStore.ACTION_IMAGE_CAPTURE);
                startActivityForResult(it, REQ_CAMERA);
            }
        });
    }

    @Override public String location() {
        try {
            android.location.LocationManager lm =
                    (android.location.LocationManager) getSystemService(LOCATION_SERVICE);
            android.location.Location l = lm.getLastKnownLocation(
                    android.location.LocationManager.NETWORK_PROVIDER);
            if (l == null) l = lm.getLastKnownLocation(android.location.LocationManager.GPS_PROVIDER);
            if (l == null) return "";
            return l.getLatitude() + "," + l.getLongitude();
        } catch (SecurityException e) {
            return "";
        } catch (Exception e) {
            return "";
        }
    }

    @Override public void startRecording() {
        runOnUiThread(new Runnable() {
            @Override public void run() {
                if (recorder != null) return;
                try {
                    recordingPath = new File(getCacheDir(),
                            "agui-record-" + System.currentTimeMillis() + ".3gp").getAbsolutePath();
                    recorder = new MediaRecorder();
                    recorder.setAudioSource(MediaRecorder.AudioSource.MIC);
                    recorder.setOutputFormat(MediaRecorder.OutputFormat.THREE_GPP);
                    recorder.setAudioEncoder(MediaRecorder.AudioEncoder.AMR_NB);
                    recorder.setOutputFile(recordingPath);
                    recorder.prepare();
                    recorder.start();
                } catch (Exception e) {
                    Toast.makeText(MainActivity.this, "录音启动失败：" + e.getMessage(), Toast.LENGTH_LONG).show();
                    if (recorder != null) { recorder.release(); recorder = null; }
                    recordingPath = null;
                }
            }
        });
    }

    @Override public void stopRecording() {
        runOnUiThread(new Runnable() {
            @Override public void run() {
                if (recorder == null) return;
                String path = recordingPath;
                try { recorder.stop(); } catch (Exception ignored) {}
                recorder.release();
                recorder = null;
                recordingPath = null;
                if (path != null) Mobile.dispatchFile(path);
            }
        });
    }

    private void ensureSensor(String name) {
        if (sensorManager == null) {
            sensorManager = (SensorManager) getSystemService(SENSOR_SERVICE);
        }
        if (sensorManager == null || sensorRegistered.contains(name)) return;
        int type = Sensor.TYPE_ACCELEROMETER;
        if (name.contains("gyro")) type = Sensor.TYPE_GYROSCOPE;
        else if (name.contains("light")) type = Sensor.TYPE_LIGHT;
        Sensor s = sensorManager.getDefaultSensor(type);
        if (s == null) return;
        sensorRegistered.add(name);
        sensorManager.registerListener(new SensorEventListener() {
            @Override public void onSensorChanged(SensorEvent e) {
                sensorValues.put(name, e.values.clone());
            }
            @Override public void onAccuracyChanged(Sensor s, int accuracy) {}
        }, s, SensorManager.SENSOR_DELAY_UI);
    }

    @Override public String sensor(String name) {
        ensureSensor(name);
        float[] v = sensorValues.get(name);
        if (v == null || v.length == 0) return "";
        if (v.length == 1) return Float.toString(v[0]);
        if (v.length == 2) return v[0] + "," + v[1];
        return v[0] + "," + v[1] + "," + v[2];
    }

    @Override protected void onDestroy() {
        if (recorder != null) {
            try { recorder.stop(); } catch (Exception ignored) {}
            recorder.release();
            recorder = null;
        }
        super.onDestroy();
    }

    @Override public void foreground(final String title, final String text) {
        Intent it = new Intent(this, AguiService.class);
        it.putExtra("title", title);
        it.putExtra("text", text);
        if (Build.VERSION.SDK_INT >= 26) startForegroundService(it); else startService(it);
    }

    @Override public void stopForeground() {
        stopService(new Intent(this, AguiService.class));
    }

    public static class AguiService extends Service {
        private static final String CHANNEL = "agui_foreground";
        private String title = "Agui 后台任务";
        private String text = "正在运行";

        @Override public IBinder onBind(Intent intent) { return null; }

        @Override public int onStartCommand(Intent intent, int flags, int startId) {
            if (intent != null) {
                if (intent.getStringExtra("title") != null) title = intent.getStringExtra("title");
                if (intent.getStringExtra("text") != null) text = intent.getStringExtra("text");
            }
            NotificationManager nm = (NotificationManager) getSystemService(NOTIFICATION_SERVICE);
            if (Build.VERSION.SDK_INT >= 26) {
                nm.createNotificationChannel(new NotificationChannel(
                        CHANNEL, "后台任务", NotificationManager.IMPORTANCE_LOW));
            }
            Notification.Builder b = Build.VERSION.SDK_INT >= 26
                    ? new Notification.Builder(this, CHANNEL)
                    : new Notification.Builder(this);
            Notification n = b.setContentTitle(title)
                    .setContentText(text)
                    .setSmallIcon(android.R.drawable.stat_sys_download)
                    .setOngoing(true)
                    .build();
            startForeground(1, n);
            return START_STICKY;
        }

        @Override public void onDestroy() {
            stopForeground(true);
            super.onDestroy();
        }
    }

    @Override public void share(final String text) {
        runOnUiThread(new Runnable() {
            @Override public void run() {
                Intent it = new Intent(Intent.ACTION_SEND);
                it.setType("text/plain");
                it.putExtra(Intent.EXTRA_TEXT, text);
                MainActivity.this.startActivity(Intent.createChooser(it, "分享"));
            }
        });
    }

    public static class AguiCanvas extends View {
        private final long id;
        private String json = "[]";
        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
        private final Paint textPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
        private final Map<String, Bitmap> bitmaps = new HashMap<>();
        private final int bg = Color.rgb(15, 23, 42);

        public AguiCanvas(android.content.Context c, long id) {
            super(c);
            this.id = id;
            setBackgroundColor(bg);
            textPaint.setColor(Color.WHITE);
            textPaint.setTextSize(18f);
            setMinimumHeight(Math.round(300 * getResources().getDisplayMetrics().density));
            setFocusable(true);
        }

        public void setOps(String json) {
            this.json = json == null ? "[]" : json;
            invalidate();
        }

        private int color(String s, int fallback) {
            if (s == null || s.isEmpty()) return fallback;
            try { return Color.parseColor(s); } catch (Exception e) { return fallback; }
        }

        private Bitmap bitmap(String src) {
            if (src == null || src.isEmpty()) return null;
            Bitmap b = bitmaps.get(src);
            if (b != null) return b;
            try {
                InputStream in = getContext().getAssets().open(src);
                b = BitmapFactory.decodeStream(in);
                in.close();
                if (b != null) bitmaps.put(src, b);
            } catch (Exception ignored) {}
            return b;
        }

        @Override protected void onDraw(Canvas c) {
            super.onDraw(c);
            try {
                JSONArray arr = new JSONArray(json);
                for (int i = 0; i < arr.length(); i++) {
                    JSONObject o = arr.getJSONObject(i);
                    String kind = o.optString("kind");
                    int col = color(o.optString("color"), Color.WHITE);
                    float w = (float) o.optDouble("width", 2);
                    paint.setStyle(Paint.Style.STROKE);
                    paint.setStrokeWidth(Math.max(1f, w));
                    paint.setColor(col);
                    if ("line".equals(kind)) {
                        c.drawLine((float)o.optDouble("x1"), (float)o.optDouble("y1"),
                                   (float)o.optDouble("x2"), (float)o.optDouble("y2"), paint);
                    } else if ("rect".equals(kind)) {
                        paint.setStyle(o.optBoolean("fill", true) ? Paint.Style.FILL : Paint.Style.STROKE);
                        c.drawRect((float)o.optDouble("x1"), (float)o.optDouble("y1"),
                                   (float)o.optDouble("x1")+(float)o.optDouble("x2"),
                                   (float)o.optDouble("y1")+(float)o.optDouble("y2"), paint);
                    } else if ("circle".equals(kind)) {
                        paint.setStyle(o.optBoolean("fill", true) ? Paint.Style.FILL : Paint.Style.STROKE);
                        c.drawCircle((float)o.optDouble("x1"), (float)o.optDouble("y1"),
                                     (float)o.optDouble("r"), paint);
                    } else if ("text".equals(kind)) {
                        textPaint.setColor(col);
                        textPaint.setTextSize((float) o.optDouble("size", 18));
                        c.drawText(o.optString("text"), (float)o.optDouble("x1"),
                                   (float)o.optDouble("y1"), textPaint);
                    } else if ("image".equals(kind)) {
                        Bitmap b = bitmap(o.optString("src"));
                        if (b == null) continue;
                        float x = (float)o.optDouble("x1"), y = (float)o.optDouble("y1");
                        float dw = (float)o.optDouble("x2", b.getWidth());
                        float dh = (float)o.optDouble("y2", b.getHeight());
                        float sw = (float)o.optDouble("sw", 0), sh = (float)o.optDouble("sh", 0);
                        android.graphics.Rect src = (sw > 0 && sh > 0)
                            ? new android.graphics.Rect((int)o.optDouble("sx"), (int)o.optDouble("sy"),
                                                        (int)(o.optDouble("sx")+sw), (int)(o.optDouble("sy")+sh))
                            : null;
                        android.graphics.RectF dst = new android.graphics.RectF(x, y, x+dw, y+dh);
                        c.drawBitmap(b, src, dst, null);
                    }
                }
            } catch (Exception ignored) {}
        }

        @Override public boolean onTouchEvent(MotionEvent e) {
            int action = e.getActionMasked();
            int a = action == MotionEvent.ACTION_DOWN ? 0 :
                    action == MotionEvent.ACTION_UP ? 1 :
                    action == MotionEvent.ACTION_MOVE ? 2 : 3;
            Mobile.dispatchTouch(id, (long) a, e.getX(), e.getY());
            return true;
        }
    }

}
