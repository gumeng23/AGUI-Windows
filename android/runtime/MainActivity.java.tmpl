    private CharSequence richParse(String s) {
        SpannableStringBuilder out = new SpannableStringBuilder();
        boolean bold = false, italic = false;
        int color = 0, i = 0;
        while (i < s.length()) {
            int open = s.indexOf('[', i);
            if (open < 0) {
                appendRich(out, s.substring(i), bold, italic, color);
                break;
            }
            if (open > i) appendRich(out, s.substring(i, open), bold, italic, color);
            int close = s.indexOf(']', open + 1);
            if (close < 0) {
                appendRich(out, s.substring(open), bold, italic, color);
                break;
            }
            String tag = s.substring(open + 1, close);
            if (tag.equals("b")) bold = true;
            else if (tag.equals("/b")) bold = false;
            else if (tag.equals("i")) italic = true;
            else if (tag.equals("/i")) italic = false;
            else if (tag.equals("/color")) color = 0;
            else if (tag.startsWith("color=")) {
                try { color = Color.parseColor(tag.substring(6)); } catch (Exception ignored) {}
            } else {
                appendRich(out, s.substring(open, close + 1), bold, italic, color);
            }
            i = close + 1;
        }
        return out;
    }

    private void appendRich(SpannableStringBuilder out, String text, boolean bold, boolean italic, int color) {
        if (text.isEmpty()) return;
        int start = out.length();
        out.append(text);
        int end = out.length();
        if (bold) out.setSpan(new StyleSpan(android.graphics.Typeface.BOLD), start, end, SpannableStringBuilder.SPAN_EXCLUSIVE_EXCLUSIVE);
        if (italic) out.setSpan(new StyleSpan(android.graphics.Typeface.ITALIC), start, end, SpannableStringBuilder.SPAN_EXCLUSIVE_EXCLUSIVE);
        if (color != 0) out.setSpan(new ForegroundColorSpan(color), start, end, SpannableStringBuilder.SPAN_EXCLUSIVE_EXCLUSIVE);
    }

